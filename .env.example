# Omniroute configuration template. Copy to .env and edit.
#   cp .env.example .env
# Never commit the real .env -- it is gitignored.

APP_ENV=development                 # development | production

# --- LLM provider -----------------------------------------------------------
# "mock" (default) is deterministic and needs no API key or network.
# "groq" or "gemini" require the matching key below; if the key is missing
# the system falls back to mock mode and the UI labels it MOCK MODE.
LLM_PROVIDER=mock
GROQ_API_KEY=
GEMINI_API_KEY=
# Model IDs are provider-specific and get retired over time. Verified live on
# Groq (Sept 2026): openai/gpt-oss-120b, openai/gpt-oss-20b, groq/compound-mini.
# Check https://console.groq.com/docs/models if you hit a model_not_found error.
MODEL_NAME=openai/gpt-oss-120b  # used for groq/gemini; ignored in mock mode
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- Data / branding --------------------------------------------------------
BRAND_NAME=AmazonHelp
DATA_SAMPLE_SIZE=60000
RANDOM_SEED=42

# --- Server -----------------------------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# CORS: comma-separated explicit origins. NEVER use "*" in production -- the
# backend only honors the wildcard when APP_ENV=development.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Gunicorn (Docker/production): worker count and log level.
WEB_CONCURRENCY=2
LOG_LEVEL=info

# --- Optional: Kaggle API (scripts/download_data.py alternative path) -------
KAGGLE_USERNAME=
KAGGLE_KEY=
