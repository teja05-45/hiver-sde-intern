# VERIFICATION STATUS: this image WAS built and smoke-tested as a live
# container (see FINAL_VERIFICATION.md) with Docker 29.x. The verification
# applies to the exact image built from this Dockerfile at that commit;
# rebuild after code changes.

FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY configs/ ./configs/
COPY frontend/ ./frontend/
COPY models/ ./models/
COPY reports/ ./reports/
COPY data/golden/ ./data/golden/

ENV PYTHONPATH=/app/backend
ENV APP_ENV=production

# Runs as non-root.
RUN useradd --create-home appuser
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Production WSGI server (gunicorn) -- never the Flask dev server.
# Worker/timeout/graceful-shutdown configuration lives in backend/gunicorn.conf.py.
CMD ["gunicorn", "-c", "backend/gunicorn.conf.py", "backend.wsgi:application"]
