# VERIFICATION STATUS: built and smoke-tested alongside the backend (see
# FINAL_VERIFICATION.md). The frontend is a static site (no build step);
# this container only exists for a split frontend/backend deployment.
# For local development the Flask backend serves the same files directly.

FROM nginx:alpine

COPY frontend/ /usr/share/nginx/html/
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  # Probe the static index, not /health: that location proxies to the
  # backend container, so nginx itself would look unhealthy whenever the
  # backend restarts. Backend health is gated separately by compose.
  CMD wget -q --spider http://127.0.0.1:80/index.html || exit 1
